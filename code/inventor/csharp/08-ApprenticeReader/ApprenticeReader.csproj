<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same interop DLL as Inventor. Apprentice must be INSTALLED (Inventor 2026+: separate
         "Inventor Apprentice Server 2026" download, see docs/08). No Inventor licence is used. -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBin)\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
